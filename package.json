{
  "name": "@dr-co/dsh-speech-gate",
  "version": "0.4.3",
  "description": "Speech-to-text gate for DeepSeek Harness: OpenAI-compatible API, Yandex SpeechKit or a local recognizer, with a web settings card for keys, the on/off switch and the live roster of recognizers.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "routes.mjs",
    "lib/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-speech-gate.git"
  },
  "homepage": "https://github.com/unera/dsh-speech-gate#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-speech-gate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "speech-to-text",
    "whisper",
    "yandex",
    "speechkit",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "esbuild": "^0.25.9"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
